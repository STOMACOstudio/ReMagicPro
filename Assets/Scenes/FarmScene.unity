  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CardGameTrigger
  playerTag: Player
  enemyDeckKey: Deck_OldWomanDruid
  cardRewardOptions:
  - Grizzly Bears
  - Rampant Growth
  - Wall of Ice
  - Dosan's Oldest Chant
  subtitleManager: {fileID: 1730929377}
  preBattleLines:
  - text: Ah, welcome stranger! Are you here to meditate too?
    displayDuration: 4
  - text: Oh, I see, you are on a quest against Yawgmoth.
    displayDuration: 3
  - text: 'Very well then: I do not participate to this war...'
    displayDuration: 3
  - text: ...but I can help you with my druidic knowledge.
    displayDuration: 3
  - text: Sit with me and listen to my story.
    displayDuration: 2
  interactionTextObject: {fileID: 178953647}
